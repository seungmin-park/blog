---
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '../lib/posts';

interface Props {
  active?: 'posts' | 'archive';
  progress?: boolean;
}

const { active, progress = false } = Astro.props;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase('/')} aria-label="박승민 홈">박승민<span class="dot">.log</span></a>
    <nav aria-label="주요 메뉴">
      <a href={withBase('/')} aria-current={active === 'posts' ? 'page' : undefined}>글</a>
      <a href={withBase('/archive/')} aria-current={active === 'archive' ? 'page' : undefined}>아카이브</a>
      <a href="https://www.linkedin.com/in/seungmin-park/" rel="me noreferrer">LinkedIn</a>
      <ThemeToggle />
    </nav>
  </div>
  {progress && <div class="progress-track" aria-hidden="true"><div class="progress-fill" id="progress-fill"></div></div>}
</header>
