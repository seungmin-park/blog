---
import { getCollection } from 'astro:content';
const knownTags = [...new Set((await getCollection('posts')).flatMap(post => post.data.tags))];
import '../../styles/editor.css';
import BaseLayout from '../../layouts/BaseLayout.astro';

const editorApi = import.meta.env.PUBLIC_EDITOR_API_URL ?? '';
---

<BaseLayout
  title="글쓰기 — 도토리 창고"
  description="도토리 창고의 관리자용 마크다운 에디터"
  noindex
>
  <div class="editor-page" data-api-url={editorApi}>
    <header class="editor-topbar">
      <h1 id="editor-title">새 기록</h1>

    </header>
    <div class="draft-tools"><div><button class="new-note" type="button" id="new-button">＋ 새 기록</button><select id="local-drafts" aria-label="이 기기의 초안"></select></div><details class="editor-more"><summary>더보기</summary><div><button type="button" id="load-button">서버의 글 불러오기</button><button type="button" id="download-button">Markdown 내려받기</button><button type="button" id="archive-local">기기의 초안 삭제</button><button type="button" id="restore-local" hidden>최근 삭제한 초안 복구</button><button type="button" id="delete-button" hidden>서버의 글 삭제</button></div></details></div>



    <section class="frontmatter-panel" aria-label="글 정보">
      <div class="field-grid">
        <label class="wide"><span class="field-label sr-only">제목</span><input id="title" placeholder="제목을 입력하세요" /></label>

      </div>

    </section>

    <section class="writing-panel" aria-labelledby="body-title">
      <div class="panel-heading writing-heading">
        <div><h2 id="body-title" class="sr-only">본문</h2></div>
        <div class="view-tabs" role="tablist" aria-label="편집 화면 배치">
          <button type="button" data-view="split" aria-selected="false">분할</button>
          <button class="active" type="button" data-view="write" aria-selected="true">작성</button>
          <button type="button" data-view="preview" aria-selected="false">미리보기</button>
        </div>
      </div>
      <div class="toolbar" role="toolbar" aria-label="마크다운 서식">
        <button type="button" data-format="heading" title="제목">H</button>
        <button type="button" data-format="bold" title="굵게 (Ctrl+B)"><strong>B</strong></button>
        <button type="button" data-format="italic" title="기울임">I</button>
        <button type="button" data-format="quote" title="인용">❯</button>
        <button type="button" data-format="code" title="코드 블록">&lt;/&gt;</button>
        <button type="button" data-format="list" title="목록">≡</button>
        <button type="button" data-format="link" title="링크 (Ctrl+K)">↗</button>
        <button type="button" id="image-button" title="이미지">▧</button>
        <input id="image-input" type="file" accept="image/*" hidden />
      </div>
      <div class="editor-split" id="editor-split" data-view="write">
        <div class="write-pane">
          <label for="body">작성</label>
          <textarea id="body" spellcheck="true" placeholder="Markdown으로 작성하세요."></textarea>
        </div>
        <div class="preview-pane">
          <span>미리보기</span>
          <article id="markdown-preview" class="markdown-preview"><p class="placeholder">왼쪽에 쓴 내용이 여기에 보입니다.</p></article>
        </div>
      </div>
      <div class="editor-statusbar">
        <span id="word-count">0자</span>
        <span>입력 후 자동 저장 · 서버 보관은 임시 저장</span>
      </div>
    </section>
    <section class="post-tags" aria-label="글 태그"><div class="field-grid"><div class="tag-field" aria-labelledby="tags-label"><span class="field-label" id="tags-label">태그</span><input id="tags" type="hidden" /><div class="tag-entry-row"><input id="tag-entry" list="known-tags" placeholder="태그 입력" aria-label="추가할 태그" /><button type="button" id="add-tag" disabled>추가</button></div><datalist id="known-tags">{knownTags.map(tag => <option value={tag} />)}</datalist><div id="tag-chips"></div></div></div></section>
      <details class="additional-settings"><summary>추가 설정</summary><div class="field-grid" id="meta-fields">
        <label><span>날짜</span><input id="date" type="date" /></label>
        <label><span>분류</span><input id="category" placeholder="미분류" /></label>
        <label class="wide"><span>한 줄 요약</span><input id="summary" placeholder="선택 사항" /></label>
        <label class="wide"><span>글 주소</span><input id="slug" /><small id="slug-note">자동 생성됩니다.</small></label>
        <label class="wide"><span>썸네일</span><input id="thumbnail" placeholder="선택 사항" /></label>
      </div></details>
    <footer class="editor-footer"><div class="editor-actions"><span class="save-state" id="save-state" role="status">이 기기에 저장됨</span><button class="button ghost" type="button" id="draft-button">임시 저장</button><button class="button primary" type="button" id="publish-button">발행</button></div></footer>
    <div class="connection-note" id="connection-note">
      <span class="status-dot"></span>
      <span>{editorApi ? 'GitHub 연결 상태를 확인하는 중입니다.' : '기기에 자동 저장 중 · 서버 저장은 아직 연결되지 않았습니다.'}</span>
      {editorApi && <a id="login-link" href={`${editorApi}/auth/login`}>GitHub 로그인 →</a>}
    <button type="button" id="logout-button" class="account-button" hidden>로그아웃</button></div>
  </div>

  <dialog id="message-dialog">
    <form method="dialog">
      <h2 id="dialog-title">알림</h2>
      <p id="dialog-message"></p>
      <button class="button primary" value="close">확인</button>
    </form>
  </dialog>

  <dialog id="load-dialog" class="load-dialog">
    <div class="load-dialog-head">
      <div><span>REMOTE POSTS</span><h2>저장된 글 불러오기</h2></div>
      <button type="button" id="load-close" aria-label="닫기">×</button>
    </div>
    <div id="remote-post-list" class="remote-post-list"></div>
  </dialog>

  <dialog id="delete-dialog">
    <form method="dialog">
      <h2>이 글을 삭제할까요?</h2>
      <p id="delete-message"></p>
      <div class="dialog-actions">
        <button class="button ghost" value="cancel">취소</button>
        <button class="button danger" type="button" id="delete-confirm">삭제</button>
      </div>
    </form>
  </dialog>

  <script>
    import { enhanceSelect } from '../../lib/select-menu';
    import { normalizeTags } from '../../lib/note-filters.mjs';
    import { createStore, findLocalCopy } from '../../lib/editor-store.mjs';
    import { assetPath } from '../../lib/markdown-images.mjs';
    import { micromark } from 'micromark';
    import { gfm, gfmHtml } from 'micromark-extension-gfm';
    type Draft = {
      title: string; slug: string; date: string;
      category: string; tags: string; summary: string; thumbnail: string; body: string;
    };
    type SaveStatus = 'draft' | 'public';
    type SourceRef = { status: SaveStatus; slug: string; sha: string };
    type LoadedPost = Draft & { publishedSlug?: string };
    type StoredEditor = { draft: Partial<Draft>; source: SourceRef | null; publishedSlug: string | null };
    const storageKey = 'seungmin-park-editor-draft-v1';
    const page = document.querySelector<HTMLElement>('.editor-page');
    const apiUrl = page?.dataset.apiUrl ?? '';
    const ids = ['title', 'slug', 'date', 'category', 'tags', 'summary', 'thumbnail', 'body'] as const;
    const fields = Object.fromEntries(ids.map((id) => [id, document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`)])) as Record<typeof ids[number], HTMLInputElement | HTMLTextAreaElement>;
    const preview = document.querySelector<HTMLElement>('#markdown-preview');
    const saveState = document.querySelector<HTMLElement>('#save-state');
    const wordCount = document.querySelector<HTMLElement>('#word-count');
    const connectionNote = document.querySelector<HTMLElement>('#connection-note');
    const dialog = document.querySelector<HTMLDialogElement>('#message-dialog');
    const loadDialog = document.querySelector<HTMLDialogElement>('#load-dialog');
    const deleteDialog = document.querySelector<HTMLDialogElement>('#delete-dialog');
    const deleteButton = document.querySelector<HTMLButtonElement>('#delete-button');
    const slugNote = document.querySelector<HTMLElement>('#slug-note');
    let csrfToken = '';
    let busy = false;
    let sourceRef: SourceRef | null = null;
    let publishedSlug: string | null = null;

    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' })[char] ?? char);
    const renderMarkdown = (source: string) => micromark(source, { extensions: [gfm()], htmlExtensions: [gfmHtml()] });
    const getDraft = (): Draft => ({
      title: fields.title.value.trim(), slug: fields.slug.value.trim(), date: fields.date.value,
      category: fields.category.value.trim(),
      tags: normalizeTags(fields.tags.value+','+tagEntry.value).join(', '), summary: fields.summary.value.trim(),
      thumbnail: fields.thumbnail.value.trim(), body: fields.body.value,
    });

    const previewImages = new Map<string,string>();
    const updatePreview = (pending = false) => {
      if (preview) {
        preview.innerHTML = renderMarkdown(fields.body.value);
        preview.querySelectorAll<HTMLImageElement>('img').forEach(image=>{
          const path=image.getAttribute('src')||'';
          if(path.startsWith('/assets/')) {
            image.src=assetPath(path,import.meta.env.BASE_URL);
            const local=previewImages.get(path);if(local)image.src=local;
            else if(apiUrl) { image.removeAttribute('src');fetch(`${apiUrl}/api/images/${encodeURIComponent(path.split('/').pop()!)}`,{credentials:'include'}).then(async response=>{if(response.ok){const url=URL.createObjectURL(await response.blob());previewImages.set(path,url);image.src=url;}else image.src=assetPath(path,import.meta.env.BASE_URL);}).catch(()=>{image.alt+=' (이미지를 불러오지 못했습니다)';}); }
          }
        });
      }
      const count = fields.body.value.replace(/\s/g, '').length;
      if (wordCount) wordCount.textContent = `${count.toLocaleString('ko-KR')}자`;
      if (saveState && pending) saveState.textContent = '저장 대기 중…';
    };

    const updateRecordControls = () => {
      document.querySelector('#editor-title')!.textContent=sourceRef?'글 수정':'새 기록';
      if (deleteButton) deleteButton.hidden = !sourceRef;
      if (!slugNote) return;
      const nextSlug = fields.slug.value.trim();
      if (!sourceRef || !nextSlug || nextSlug === sourceRef.slug) {
        slugNote.textContent = '글 URL에 사용합니다.';
        slugNote.classList.remove('changed');
        return;
      }
      slugNote.classList.add('changed');
      slugNote.textContent = publishedSlug
        ? `발행하면 /posts/${publishedSlug}/ 주소를 새 주소로 연결합니다.`
        : '저장에 성공한 뒤 기존 초안 파일을 정리합니다.';
    };

    const store = createStore({getItem:(key:string)=>localStorage.getItem(key),setItem:(key:string,value:string)=>localStorage.setItem(key,value)});
    let localNote: any = null;
    let dirty = false;
    let saveTimer: ReturnType<typeof setTimeout>;
    const today = () => new Intl.DateTimeFormat('en-CA', {timeZone:'Asia/Seoul',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
    const localSelect = document.querySelector<HTMLSelectElement>('#local-drafts')!;
    const localDropdown = enhanceSelect(localSelect);
    const renderLocalList = () => {
      document.querySelector<HTMLButtonElement>('#restore-local')!.hidden=store.trash().length===0;
      localSelect.replaceChildren(...store.list().map((note: any) => { const option=document.createElement('option');option.value=note.id;option.textContent=note.draft?.title || '제목 없는 기록';option.selected=note.id===localNote?.id;return option; }));localDropdown.update();
    };
    const saveLocal = () => {
      try {
        if (!localNote) throw new Error('자동 저장을 시작하지 못했습니다. Markdown 파일로 내려받아 주세요.');
        const next={...localNote,draft:getDraft(),source:sourceRef,publishedSlug};
        localNote=store.save(next,localNote.revision);dirty=false;
        if(saveState)saveState.textContent='이 기기에 저장됨';renderLocalList();return true;
      } catch(error) { if(saveState)saveState.textContent=error instanceof Error?error.message:'기기 저장 실패 · 파일로 내려받아 주세요';return false; }
    };
    const slugify = (value: string) => value.toLocaleLowerCase('ko').trim().replace(/[^a-z0-9가-힣]+/g,'-').replace(/^-|-$/g,'').slice(0,100);
    const openLocal = (note: any) => {
      tagEntry.value='';addTag.disabled=true;
      localNote=note;sourceRef=note.source??null;publishedSlug=note.publishedSlug??null;
      ids.forEach(id=>{fields[id].value=String(note.draft?.[id]??(id==='date'?today():''));});
      // Keep an existing URL stable when a title changes, including after reload.
      fields.slug.dataset.edited='true';dirty=false;updatePreview();updateRecordControls();renderLocalList();
      document.querySelector('#editor-title')!.textContent=sourceRef?'글 수정':'새 기록';
      renderTagChips();if(saveState)saveState.textContent='이 기기에 저장됨';
    };
    const newLocal = () => {
      openLocal(store.create({draft:{date:today(),slug:'note-'+crypto.randomUUID().slice(0,12)},source:null,publishedSlug:null}));
      fields.title.focus();
    };
    document.querySelector('#archive-local')?.addEventListener('click',()=>{if(busy||!saveLocal())return;store.archive(localNote.id);const next=store.list()[0];if(next)openLocal(store.select(next.id));else newLocal();});
    document.querySelector('#restore-local')?.addEventListener('click',()=>{if(busy||!saveLocal())return;const note=store.trash()[0];if(note)openLocal(store.restore(note.id));});
    const restore = () => {
      try {
        let note=store.active();
        if(!note){const old=localStorage.getItem(storageKey);if(old){const value=JSON.parse(old);note=store.create(value.draft?value:{draft:value,source:null});}else {newLocal();return;}}
        openLocal(note);if(saveState)saveState.textContent='이 기기의 초안을 불러왔습니다';
      } catch(error){if(saveState)saveState.textContent=error instanceof Error?error.message:'초안 복원 실패';}
    };
    document.querySelector('#new-button')?.addEventListener('click',()=>{if(busy)return;if(!saveLocal()){showMessage('현재 원고를 먼저 보관해 주세요',saveState?.textContent || '기기 저장 실패');return;}newLocal();});
    localSelect.addEventListener('change',()=>{const id=localSelect.value;if(!saveLocal()){localSelect.value=localNote.id;localDropdown.update();showMessage('현재 원고를 먼저 보관해 주세요',saveState?.textContent || '기기 저장 실패');return;}openLocal(store.select(id));});
    document.addEventListener('visibilitychange',()=>{if(document.hidden&&dirty)saveLocal();});
    window.addEventListener('pagehide',()=>{if(dirty)saveLocal();});
    const renderTagChips = () => {
      const tags=normalizeTags(fields.tags.value);
      const root=document.querySelector('#tag-chips')!;root.replaceChildren();
      tags.forEach(tag=>{const button=document.createElement('button');button.type='button';button.textContent=tag+' ×';button.setAttribute('aria-label',tag+' 태그 제거');button.addEventListener('click',()=>{fields.tags.value=tags.filter(t=>t!==tag).join(', ');fields.tags.dispatchEvent(new Event('input'));});root.append(button);});
    };
    const tagEntry=document.querySelector<HTMLInputElement>('#tag-entry')!;
    const addTag=document.querySelector<HTMLButtonElement>('#add-tag')!;
    const commitTag = () => {
      fields.tags.value=normalizeTags(fields.tags.value+','+tagEntry.value).join(', ');tagEntry.value='';addTag.disabled=true;
      fields.tags.dispatchEvent(new Event('input'));renderTagChips();
    };
    tagEntry.addEventListener('input',()=>{addTag.disabled=!tagEntry.value.trim();dirty=true;clearTimeout(saveTimer);saveTimer=setTimeout(saveLocal,500);});
    tagEntry.addEventListener('keydown',event=>{if(event.key==='Enter'){event.preventDefault();commitTag();}});
    addTag.addEventListener('click',commitTag);
    fields.tags.addEventListener('input',renderTagChips);
    const smallScreen=window.matchMedia('(max-width:700px)');
    smallScreen.addEventListener('change',()=>{if(smallScreen.matches)document.querySelector<HTMLButtonElement>('[data-view="write"]')?.click();});

    const stableCommit = (value: string) => {
      let hash = 0;
      for (const character of value) hash = Math.imul(31, hash) + character.charCodeAt(0) | 0;
      return Math.abs(hash).toString(16).slice(0, 6).padStart(6, '0');
    };

    const toMarkdown = (draft: Draft, status: SaveStatus) => {
      const tags = draft.tags.split(',').map((tag) => tag.trim()).filter(Boolean);
      const yaml = [
        '---', `title: ${JSON.stringify(draft.title)}`, `slug: ${JSON.stringify(draft.slug)}`,
        `date: ${draft.date}`, `updated: ${today()}`, `status: ${status}`,
        `tags: ${JSON.stringify(tags)}`, `category: ${JSON.stringify(draft.category)}`,
        ...(draft.thumbnail ? [`thumbnail: ${JSON.stringify(draft.thumbnail)}`] : []),
        `summary: ${JSON.stringify(draft.summary)}`, 'author: "박승민"',
        `commit: "${stableCommit(`${draft.slug}-${draft.date}`)}"`, 'featured: false', '---', '',
      ];
      return `${yaml.join('\n')}${draft.body.trim()}\n`;
    };

    const showMessage = (title: string, message: string, buttonLabel = '확인') => {
      const titleEl = document.querySelector('#dialog-title');
      const messageEl = document.querySelector('#dialog-message');
      const buttonEl = dialog?.querySelector<HTMLButtonElement>('button[value="close"]');
      if (titleEl) titleEl.textContent = title;
      if (messageEl) messageEl.textContent = message;
      if (buttonEl) buttonEl.textContent = buttonLabel;
      if (!dialog) return Promise.resolve();
      dialog.showModal();
      return new Promise<void>((resolve) => dialog.addEventListener('close', () => resolve(), { once: true }));
    };

    const readApiError = async (response: Response, fallback: string) => {
      const result = await response.json().catch(() => null);
      return typeof result?.error === 'string' ? result.error : fallback;
    };

    const wrapSelection = (before: string, after = before, placeholder = '텍스트') => {
      const area = fields.body as HTMLTextAreaElement;
      const start = area.selectionStart;
      const end = area.selectionEnd;
      const selected = area.value.slice(start, end) || placeholder;
      area.setRangeText(`${before}${selected}${after}`, start, end, 'select');
      area.focus();
      dirty=true;updatePreview(true);clearTimeout(saveTimer);saveTimer=setTimeout(saveLocal,500);
    };

    const formatters: Record<string, () => void> = {
      heading: () => wrapSelection('## ', '', '제목'), bold: () => wrapSelection('**', '**'),
      italic: () => wrapSelection('*', '*'), quote: () => wrapSelection('> ', '', '인용문'),
      code: () => wrapSelection('```ts\n', '\n```', 'code'), list: () => wrapSelection('- ', '', '목록'),
      link: () => wrapSelection('[', '](https://)', '링크 텍스트'),
    };

    ids.forEach((id) => fields[id].addEventListener('input', () => {
      if (id === 'title' && !fields.slug.dataset.edited) fields.slug.value = slugify(fields.title.value);
      dirty=true;updatePreview(true);clearTimeout(saveTimer);saveTimer=setTimeout(saveLocal,500);
    }));
    fields.slug.addEventListener('input', () => { fields.slug.dataset.edited = 'true'; updateRecordControls(); });
    document.querySelectorAll<HTMLButtonElement>('[data-format]').forEach((button) => button.addEventListener('click', () => formatters[button.dataset.format ?? '']?.()));
    fields.body.addEventListener('keydown', (event) => {
      const keyboardEvent = event as KeyboardEvent;
      if (!(keyboardEvent.ctrlKey || keyboardEvent.metaKey)) return;
      if (keyboardEvent.key.toLowerCase() === 'b') { keyboardEvent.preventDefault(); formatters.bold(); }
      if (keyboardEvent.key.toLowerCase() === 'k') { keyboardEvent.preventDefault(); formatters.link(); }
      if (keyboardEvent.key.toLowerCase() === 's') { keyboardEvent.preventDefault(); saveLocal(); }
    });

    const imageInput = document.querySelector<HTMLInputElement>('#image-input');
    document.querySelector('#image-button')?.addEventListener('click', () => imageInput?.click());
    const handleImage = async (file: File) => {
      if (!file || busy) return;
      const safeName = file.name.toLocaleLowerCase().replace(/[^a-z0-9._-]+/g, '-');
      if (!apiUrl) {
        wrapSelection(`![${file.name}](/assets/images/${safeName})`, '', '');
        showMessage('이미지 경로를 넣었습니다', '로컬 모드에서는 이미지 파일을 public/assets/images에 직접 추가해야 합니다.');
        return;
      }
      try {
        const form = new FormData();
        form.append('file', file, safeName);
        const response = await fetch(`${apiUrl}/api/images`, { method: 'POST', credentials: 'include', headers: { 'X-CSRF-Token': csrfToken }, body: form });
        if (!response.ok) throw new Error('이미지를 업로드하지 못했습니다.');
        const result = await response.json();
        previewImages.set(result.path,URL.createObjectURL(file));
        wrapSelection(`![${file.name}](${result.path})`, '', '');
      } catch (error) { showMessage('이미지 업로드 실패', error instanceof Error ? error.message : '다시 시도해 주세요.'); }
    };
    imageInput?.addEventListener('change', () => {
      const file = imageInput.files?.[0];
      if (file) handleImage(file);
    });

    const writePane = document.querySelector<HTMLElement>('.write-pane');
    writePane?.addEventListener('dragover', (event) => { event.preventDefault(); writePane.classList.add('dragging'); });
    writePane?.addEventListener('dragleave', () => writePane.classList.remove('dragging'));
    writePane?.addEventListener('drop', (event) => {
      event.preventDefault();
      writePane.classList.remove('dragging');
      const file = event.dataTransfer?.files[0];
      if (file?.type.startsWith('image/')) handleImage(file);
    });

    document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((button) => button.addEventListener('click', () => {
      const split = document.querySelector<HTMLElement>('#editor-split');
      if (split) split.dataset.view = button.dataset.view ?? 'split';
      document.querySelectorAll<HTMLButtonElement>('[data-view]').forEach((item) => {
        const selected = item === button;
        item.classList.toggle('active', selected);
        item.setAttribute('aria-selected', String(selected));
      });
    }));

    document.querySelector('#meta-toggle')?.addEventListener('click', (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      const meta = document.querySelector<HTMLElement>('#meta-fields');
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!expanded));
      button.textContent = expanded ? '펼치기' : '접기';
      if (meta) meta.hidden = expanded;
    });

    document.querySelector('#download-button')?.addEventListener('click', () => {
      const draft = getDraft();
      draft.title ||= '제목 없는 기록';
      const blob = new Blob([toMarkdown(draft, 'draft')], { type: 'text/markdown;charset=utf-8' });
      const link = document.createElement('a');
      link.href = URL.createObjectURL(blob);
      link.download = `${draft.date}-${draft.slug}.md`;
      link.click();
      URL.revokeObjectURL(link.href);
    });

    document.querySelector('#load-button')?.addEventListener('click', async () => {
      if(busy)return;
      if (!apiUrl) { showMessage('OAuth API 연결이 필요합니다', 'PUBLIC_EDITOR_API_URL을 설정한 뒤 GitHub에 로그인해 주세요.'); return; }
      const list = document.querySelector<HTMLElement>('#remote-post-list');
      if (list) list.innerHTML = '<p class="loading-posts">목록을 불러오는 중…</p>';
      loadDialog?.showModal();
      try {
        const response = await fetch(`${apiUrl}/api/posts`, { credentials: 'include' });
        if (!response.ok) throw new Error(response.status === 401 ? 'GitHub 로그인이 필요합니다.' : '글 목록을 불러오지 못했습니다.');
        const result = await response.json();
        if (!list) return;
        if (!result.posts.length) { list.innerHTML = '<p class="loading-posts">저장된 글이 없습니다.</p>'; return; }
        list.innerHTML = '';
        const labels: Record<string, string> = { draft: '임시저장', public: '발행됨' };
        result.posts.forEach((post: { status: string; slug: string }) => {
          const button = document.createElement('button');
          button.type = 'button';
          button.innerHTML = `<span class="remote-status ${post.status}">${labels[post.status] ?? post.status}</span><strong>${escapeHtml(post.slug)}</strong><span aria-hidden="true">→</span>`;
          button.addEventListener('click', async () => {
            try {
              const detail = await fetch(`${apiUrl}/api/posts/${encodeURIComponent(post.status)}/${encodeURIComponent(post.slug)}`, { credentials: 'include' });
              if (!detail.ok) throw new Error('글을 불러오지 못했습니다.');
              const result = await detail.json();
              const loaded = result.post as LoadedPost;
              if (!saveLocal()) { loadDialog?.close();showMessage('현재 원고를 먼저 보관해 주세요',saveState?.textContent || '기기 저장에 실패했습니다. 현재 내용을 내려받고 다시 열어 주세요.');return; }
              const existing = findLocalCopy(store.list(),result.source,loaded,ids);
              openLocal(existing ? store.select(existing.id) : store.create({draft:loaded,source:result.source,publishedSlug:loaded.publishedSlug || null}));
              sourceRef = result.source as SourceRef;
              publishedSlug = loaded.publishedSlug || (sourceRef.status === 'public' ? sourceRef.slug : null);
              fields.slug.dataset.edited = 'true';
              updatePreview();
              updateRecordControls();
              saveLocal();
              loadDialog?.close();
            } catch (error) { loadDialog?.close(); showMessage('불러오기 실패', error instanceof Error ? error.message : '다시 시도해 주세요.'); }
          });
          list.append(button);
        });
      } catch (error) {
        if (list) list.innerHTML = `<p class="loading-posts">${escapeHtml(error instanceof Error ? error.message : '다시 시도해 주세요.')}</p>`;
      }
    });
    document.querySelector('#load-close')?.addEventListener('click', () => loadDialog?.close());

    const saveToGitHub = async (status: SaveStatus) => {
      commitTag();
      const draft = getDraft();
      if (status === 'public' && (!draft.title || !draft.body.trim())) { showMessage('아직 비어 있는 항목이 있습니다', '발행하려면 제목과 본문을 입력해 주세요.'); return; }
      if (!saveLocal()) return;
      await checkSession();
      if (apiUrl && !csrfToken) { showMessage('다시 로그인해 주세요', '현재 원고는 이 기기에 저장했습니다. GitHub 로그인 후 같은 초안을 열어 다시 저장하세요.'); return; }
      if (!apiUrl) { showMessage('로컬 편집 모드입니다', 'Markdown 받기로 파일을 저장하거나 PUBLIC_EDITOR_API_URL을 설정해 GitHub OAuth API를 연결해 주세요.'); return; }
      const button = document.querySelector<HTMLButtonElement>(status === 'public' ? '#publish-button' : '#draft-button');
      const originalLabel = button?.textContent ?? '';
      if(busy)return;busy=true;localSelect.disabled=true;localDropdown.update();ids.forEach(id=>fields[id].readOnly=true);
      document.querySelector<HTMLButtonElement>('#new-button')!.disabled=true;
      if (button) { button.disabled = true; button.textContent = status === 'public' ? '발행 중…' : '저장 중…'; }
      try {
        const response = await fetch(`${apiUrl}/api/posts`, { method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }, body: JSON.stringify({ ...draft, status, source: sourceRef }) });
        if (!response.ok) throw new Error(response.status === 401 ? 'GitHub 로그인이 필요합니다.' : await readApiError(response, '저장 요청을 처리하지 못했습니다.'));
        const result = await response.json();
        sourceRef = result.source as SourceRef;
        publishedSlug = result.publishedSlug || null;
        updateRecordControls();
        saveLocal();
        if (result.warnings?.length) { await showMessage('본문 저장 완료 · 정리 확인 필요', result.warnings.join(' ')); return; }
        if (status === 'public') {
          await showMessage(
            '발행을 요청했습니다',
            '공개 저장소에 반영했습니다. 메인 페이지로 이동한 뒤에도 GitHub Pages 배포가 끝날 때까지 이전 내용이 잠시 보일 수 있습니다.',
            '메인으로 이동',
          );
          window.location.assign(new URL('../', window.location.href).href);
        } else {
          showMessage(
            '임시 저장했습니다',
            '비공개 원고 저장소에 보관했습니다. 기존 공개 글이 있더라도 공개본은 그대로 유지됩니다.',
          );
        }
      } catch (error) { showMessage('저장하지 못했습니다', error instanceof Error ? error.message : '잠시 후 다시 시도해 주세요.'); }
      finally {busy=false;localSelect.disabled=false;localDropdown.update();ids.forEach(id=>fields[id].readOnly=false);document.querySelector<HTMLButtonElement>('#new-button')!.disabled=false;if (button) { button.disabled = false; button.textContent = originalLabel; } }
    };

    document.querySelector('#draft-button')?.addEventListener('click', () => saveToGitHub('draft'));
    document.querySelector('#publish-button')?.addEventListener('click', () => saveToGitHub('public'));

    const resetEditor = () => {
      sourceRef = null;
      publishedSlug = null;
      ids.forEach((id) => { fields[id].value = id === 'date' ? today() : ''; });
      delete fields.slug.dataset.edited;
      // Preserve the deleted article as a local recovery copy.
      newLocal();
      updatePreview();
      updateRecordControls();
      if (saveState) saveState.textContent = '새 글을 작성할 수 있습니다.';
    };

    deleteButton?.addEventListener('click', () => {
      if (!sourceRef || busy || !saveLocal()) return;
      const message = document.querySelector<HTMLElement>('#delete-message');
      if (message) message.textContent = sourceRef.status === 'public'
        ? `발행 글 “${sourceRef.slug}”을 현재 사이트에서 내립니다. Git 히스토리와 외부 캐시에는 과거 내용이 남을 수 있으며, 별도 임시 저장본은 삭제하지 않습니다.`
        : `임시 저장 글 “${sourceRef.slug}”을 비공개 원고 저장소에서 삭제합니다. 업로드한 이미지는 다른 글에서 사용할 수 있어 자동 삭제하지 않습니다.`;
      deleteDialog?.showModal();
    });

    const deleteConfirmButton = document.querySelector<HTMLButtonElement>('#delete-confirm');
    deleteConfirmButton?.addEventListener('click', async () => {
      if (!sourceRef || !apiUrl) return;
      const button = deleteConfirmButton;
      const target = sourceRef;
      button.disabled = true;
      button.textContent = '삭제 중…';
      try {
        const response = await fetch(`${apiUrl}/api/posts/${encodeURIComponent(target.status)}/${encodeURIComponent(target.slug)}`, {
          method: 'DELETE',
          credentials: 'include',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ sha: target.sha }),
        });
        if (!response.ok) throw new Error(response.status === 401 ? 'GitHub 로그인이 필요합니다.' : await readApiError(response, '글을 삭제하지 못했습니다.'));
        deleteDialog?.close();
        resetEditor();
        showMessage(
          target.status === 'public' ? '발행 글을 내렸습니다' : '임시 저장 글을 삭제했습니다',
          target.status === 'public'
            ? '다음 GitHub Pages 빌드부터 사이트에서 사라집니다. 과거 Git 기록은 삭제되지 않습니다.'
            : '비공개 원고 파일을 삭제했습니다.',
        );
      } catch (error) {
        deleteDialog?.close();
        showMessage('삭제하지 못했습니다', error instanceof Error ? error.message : '잠시 후 다시 시도해 주세요.');
      } finally {
        button.disabled = false;
        button.textContent = '삭제';
      }
    });

    const checkSession = async () => {
      if (!apiUrl || !connectionNote) return;
      try {
        const response = await fetch(`${apiUrl}/api/session`, { credentials: 'include' });
        if (!response.ok) throw new Error();
        const session = await response.json();
        csrfToken = session.csrf;
        connectionNote.classList.add('connected');
        connectionNote.querySelector('span:nth-child(2)')!.textContent = `${session.login} 계정으로 연결됨`;
        const login=connectionNote.querySelector<HTMLAnchorElement>('a');if(login)login.hidden=true;document.querySelector<HTMLButtonElement>('#logout-button')!.hidden=false;
      } catch { csrfToken='';connectionNote.classList.remove('connected');connectionNote.querySelector('span:nth-child(2)')!.textContent='GitHub 로그인이 필요합니다. 원고는 이 기기에 보관됩니다.';const login=connectionNote.querySelector<HTMLAnchorElement>('a');if(login)login.hidden=false; }
    };

    document.querySelector('#login-link')?.addEventListener('click',event=>{if(!saveLocal())event.preventDefault();});
    document.querySelector('#logout-button')?.addEventListener('click',async()=>{if(!saveLocal())return;const response=await fetch(`${apiUrl}/api/logout`,{method:'POST',credentials:'include',headers:{'X-CSRF-Token':csrfToken}});if(response.ok){csrfToken='';document.querySelector<HTMLButtonElement>('#logout-button')!.hidden=true;await checkSession();}else showMessage('로그아웃 실패','다시 시도해 주세요.');});
    restore();
    checkSession();
    window.setInterval(()=>{if(dirty)saveLocal();}, 30_000);
    window.addEventListener('beforeunload',event=>{if(dirty&&!saveLocal()){event.preventDefault();event.returnValue='';}});
  </script>
</BaseLayout>
