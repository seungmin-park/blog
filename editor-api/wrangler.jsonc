{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seungmin-park-editor-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-20",
  "vars": {
    "ALLOWED_GITHUB_LOGIN": "seungmin-park",
    "PUBLIC_REPO_OWNER": "seungmin-park",
    "PUBLIC_REPO_NAME": "blog",
    "PRIVATE_REPO_OWNER": "seungmin-park",
    "PRIVATE_REPO_NAME": "blog-draft",
    "EDITOR_ORIGIN": "https://seungmin-park.github.io",
    "EDITOR_RETURN_URL": "https://seungmin-park.github.io/blog/admin/"
  }
}
